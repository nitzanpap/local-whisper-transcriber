{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rescribe",
  "version": "0.1.0",
  "identifier": "com.rescribe.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns"],
    "category": "Productivity",
    "shortDescription": "Local transcription with whisper.cpp",
    "longDescription": "Turn recordings into transcripts on your own machine. Nothing is uploaded.",
    "resources": {
      "../../app.py": "backend/app.py",
      "../../config.py": "backend/config.py",
      "../../tools.py": "backend/tools.py",
      "../../transcribe.py": "backend/transcribe.py",
      "../../jobs.py": "backend/jobs.py",
      "../../library.py": "backend/library.py",
      "../../models.py": "backend/models.py",
      "../../models.json": "backend/models.json",
      "../../diagnostics.py": "backend/diagnostics.py",
      "../../record.py": "backend/record.py",
      "../../selfcheck.py": "backend/selfcheck.py",
      "../../saving.py": "backend/saving.py",
      "../../mixing.py": "backend/mixing.py",
      "../../levels.py": "backend/levels.py",
      "../../devices.py": "backend/devices.py",
      "../../syshelper.py": "backend/syshelper.py",
      "../../retention.py": "backend/retention.py",
      "../../watch.py": "backend/watch.py",
      "../../web/": "backend/web/",
      "../../mac/": "backend/mac/"
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
